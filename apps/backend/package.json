{
  "name": "@cooklog/backend",
  "version": "0.1.0",
  "private": true,
  "description": "CookLog Backend local/mock foundation",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/app/server.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test dist/tests/health/*.test.js",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "fastify": "5.11.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
