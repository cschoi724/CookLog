{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.cooklog.app/contracts/common/installation-token.schema.json",
  "title": "설치 access token 응답 data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "access_token",
    "token_type",
    "expires_in",
    "installation_id",
    "attestation_provider"
  ],
  "properties": {
    "access_token": {
      "type": "string",
      "minLength": 64,
      "maxLength": 4096
    },
    "token_type": {
      "const": "Bearer"
    },
    "expires_in": {
      "type": "integer",
      "minimum": 60,
      "maximum": 900
    },
    "installation_id": {
      "type": "string",
      "format": "uuid"
    },
    "attestation_provider": {
      "enum": ["apple_app_attest", "firebase_app_check"]
    }
  }
}

