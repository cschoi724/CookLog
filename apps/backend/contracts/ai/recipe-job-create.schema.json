{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cooklog.app/ai/recipe-job-create.schema.json",
  "title": "CookLog AI recipe job create request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "snapshot_id",
    "snapshot_revision",
    "snapshot_sha256",
    "locale",
    "steps"
  ],
  "properties": {
    "contract_version": {
      "const": "ai-recipe-job.v1"
    },
    "snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "snapshot_revision": {
      "type": "integer",
      "minimum": 1
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "locale": {
      "const": "ko-KR"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "order",
          "recorded_at",
          "transcript"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "format": "uuid"
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "transcript": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    }
  }
}
