{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cooklog.app/stt/remote-stt-transcription-result.schema.json",
  "title": "CookLog remote STT result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "clip_id",
    "transcript",
    "locale",
    "audio_deleted"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "clip_id": {
      "type": "string",
      "format": "uuid"
    },
    "transcript": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "locale": {
      "type": "string",
      "enum": [
        "ko-KR"
      ]
    },
    "audio_deleted": {
      "const": true
    }
  }
}

